# ── App ─────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# CORS origin for the Next.js frontend (Vercel URL in prod, localhost in dev)
FRONTEND_ORIGIN=http://localhost:3001

# IANA timezone for calendar-day logic (leave dates, attendance check-in day)
TIMEZONE=Asia/Kolkata

# ── Database ────────────────────────────────────────────────────────
# Local dev (docker-compose Postgres). On Railway this is injected automatically.
DATABASE_URL=postgresql://peoplehub:peoplehub@localhost:5432/peoplehub?schema=public

# ── Auth / JWT ──────────────────────────────────────────────────────
# Use long random strings in production (e.g. `openssl rand -hex 32`).
JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_TTL=900s
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_TTL=7d

# Name of the HTTP-only refresh cookie
REFRESH_COOKIE_NAME=peoplehub_rt

# Base64-encoded 32-byte key for AES-256-GCM encryption of PII columns
# (PAN, PF/ESIC numbers, bank account numbers). Generate with:
# openssl rand -base64 32
ENCRYPTION_KEY=change-me-base64-32-byte-key

# ── Seed admin (used by prisma/seed.ts) ─────────────────────────────
SEED_ADMIN_EMAIL=nithin.gangadhar@phaze-dynamics.com
SEED_ADMIN_PASSWORD=ChangeMe123!

# ── Vault file storage (Cloudflare R2, S3-compatible) ───────────────
# Optional locally: the app boots without these, but Vault file
# upload/download will error until all of R2_ENDPOINT/R2_ACCESS_KEY_ID/
# R2_SECRET_ACCESS_KEY/R2_BUCKET are set. Endpoint is the R2 S3 API URL,
# e.g. https://<accountid>.r2.cloudflarestorage.com
R2_ENDPOINT=
R2_REGION=auto
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Presigned upload/download URL lifetime, seconds (short-lived by design).
R2_PRESIGN_TTL_SECONDS=300

# ── Vault preview conversion (Gotenberg — separate Railway service) ──
# Base URL of the Gotenberg service that converts Office docs → PDF.
# Optional: without it, PDF/image previews still work; Office-doc
# conversions fail gracefully (previewStatus → FAILED).
GOTENBERG_URL=
GOTENBERG_TIMEOUT_MS=60000

# ── Transactional email (Resend) ─────────────────────────────────────
# Optional: the app boots without these and EmailService only errors when a
# send is actually attempted. The real key lives in the Railway environment —
# keep it out of this file and out of commits.
RESEND_API_KEY=
# Must be on a domain verified in Resend (SPF + DKIM). Accepts a bare address
# or "Name <addr@domain>".
EMAIL_FROM=
# Optional default Reply-To (use a monitored inbox).
EMAIL_REPLY_TO=
# Staging/dev safety net: comma-separated addresses and/or domains
# ("ops@acme.com, @acme.com"). Anything else is dropped with a warning.
# Leave empty in production.
EMAIL_ALLOWED_RECIPIENTS=
# true = log each email instead of delivering it (recommended locally).
EMAIL_DRY_RUN=true

# ── Web Push notifications (VAPID) ───────────────────────────────────
# A completely separate channel from Resend above: this is the Web Push API,
# delivering notifications to a device through Apple/Google/Mozilla's push
# services. It shares no keys, no library and no code path with email.
#
# Generate the keypair ONCE per deployment and keep it forever — rotating it
# invalidates every existing device subscription:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
#
# Optional: the app boots without these; PushNotificationService only errors
# when a send is attempted, and the UI hides the notification controls.
VAPID_PUBLIC_KEY=
# Never commit this. In production it exists only as a Railway secret.
VAPID_PRIVATE_KEY=
# Who to contact about this application's pushes — the push services require
# it. Either "mailto:you@domain" or an https:// URL.
VAPID_SUBJECT=mailto:info@phaze-dynamics.com
